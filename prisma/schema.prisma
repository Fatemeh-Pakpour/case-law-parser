generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  HTML
  PDF
}

model CaseLaw {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title        String?
  decisionType String?
  decisionDate DateTime?
  office       String?
  court        String?
  caseNumber   String?
  summary      String?
  conclusion   String?

  sourceType   SourceType
  sourceUrl    String?
  originalName String?
  mimeType     String?

  extractedText String?

  llmProvider    String?
  llmModel       String?
  llmRawResponse Json?

  @@index([caseNumber])
  @@index([decisionDate])
  @@index([court])
}
